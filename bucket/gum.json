{
    "version": "1.1.0",
    "description": "Switch between multiple Git identities (user.name, user.email, SSH keys) with one command",
    "homepage": "https://github.com/ziyifast/gum",
    "license": "MIT",
    "url": "https://github.com/ziyifast/gum/archive/refs/tags/v1.1.0.tar.gz",
    "hash": "5d6d251018669125ac144723a8e80d1236cab90bd570c3ae7a58d6b9eee1ddfb",
    "extract_dir": "gum-1.1.0",
    "depends": [
        "git"
    ],
    "pre_install": [
        "$cmdContent = \"@echo off`r`nbash `\"$dir\\gum.sh`\" %*`r`n\"",
        "Set-Content -Path \"$dir\\gum.cmd\" -Value $cmdContent -NoNewline -Encoding ASCII"
    ],
    "bin": "gum.cmd",
    "notes": [
        "gum is a Bash script. On Windows, it runs through Git Bash (bundled with Git for Windows).",
        "Make sure 'bash' is in your PATH. Git for Windows adds it automatically.",
        "Run 'gum init' to set up your first profiles.",
        "Profiles are stored in ~/.gum/"
    ],
    "checkver": {
        "github": "https://github.com/ziyifast/gum"
    },
    "autoupdate": {
        "url": "https://github.com/ziyifast/gum/archive/refs/tags/v$version.tar.gz",
        "extract_dir": "gum-$version"
    }
}
